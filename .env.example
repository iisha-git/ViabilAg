# Copy to .env if you need to change anything. All values are optional; defaults work.
# (The backend reads real environment variables; use `export` or your host's settings panel.)
# Never commit a real .env: it is git-ignored on purpose.

# Where the trained model and content live (defaults are inside this repo)
BIOOASIS_MODEL_PATH=ml/artifacts/model.json
BIOOASIS_EVIDENCE_PATH=data/evidence/evidence.json
BIOOASIS_RULES_PATH=data/evidence/rules.json
BIOOASIS_SAMPLES_PATH=data/samples.json
BIOOASIS_FRONTEND_DIR=frontend

# Weather lookup
BIOOASIS_WEATHER_URL=https://api.open-meteo.com/v1/forecast
BIOOASIS_WEATHER_TIMEOUT_S=8

# Upload guard rails for POST /api/ocr
BIOOASIS_OCR_MAX_BYTES=12582912
BIOOASIS_OCR_MAX_PIXELS=40000000
# OCR worker: max simultaneous reads, and a hard timeout per read (seconds)
BIOOASIS_OCR_CONCURRENCY=2
BIOOASIS_OCR_TIMEOUT_S=30

# Per-IP request limits per minute (1 = on, 0 = off). OCR is CPU-heavy, so lowest.
BIOOASIS_RATE_LIMIT=1
BIOOASIS_RATE_OCR=10
BIOOASIS_RATE_ANALYZE=30
BIOOASIS_RATE_CLASSIFY=60
BIOOASIS_RATE_CONDITIONS=60
BIOOASIS_RATE_DEFAULT=240
# Global per-IP cap across the whole API (per minute)
BIOOASIS_RATE_GLOBAL=300

# Only if the website is hosted separately from the backend (see docs/deployment.md)
BIOOASIS_CORS_ORIGINS=
